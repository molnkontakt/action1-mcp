# Copy to .env and fill in. Never commit the filled-in copy.
# Credentials come from the Action1 console: Configuration → API Credentials.

ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=

# NorthAmerica (default) | NA-2 | Europe | Australia
ACTION1_REGION=NorthAmerica

# Optional: org used when a tool is called without org_id.
# Get it from action1_list_organizations.
ACTION1_DEFAULT_ORG_ID=

# Required before exposing the HTTP transport to anything.
# Generate: openssl rand -base64 36 | tr -d '=+/' | cut -c1-48
ACTION1_MCP_BEARER=

# Optional tuning — defaults shown.
# ACTION1_RATE_LIMIT_PER_MINUTE=25   # Action1's ceiling is 30/min per tenant
# ACTION1_MAX_ITEMS=1000
# ACTION1_PAGE_SIZE=200
# ACTION1_TIMEOUT_SECONDS=60
# ACTION1_MAX_429_RETRIES=3
